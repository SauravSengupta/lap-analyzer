# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/

# Virtual environments (any location)
.venv/
**/.venv/
venv/
env/

# Project data — large & personal. Everything under data/ is ignored EXCEPT
# data/samples/ (the committed demo bundle: 3 sessions/track + sample corpus +
# centerlines). Full corpus ships as a GitHub Release asset, raw CSVs stay local.
data/*
!data/samples/

# Scratch (legacy notebooks, backups — created in Phase 3)
scratch/

# Local tooling / agent state
.claude/
.playwright-mcp/
.streamlit/

# Internal planning docs (AI plans + specs) — kept on disk, not published
docs/superpowers/

# Env & secrets (commit .env.example, never .env)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Generated plot outputs from scripts/
scripts/*.png
